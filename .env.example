EDGE_ID=edge-dev-01

EDGE_ZONE=dev

EDGE_HTTP_PORT=8080

# Adresse du broker MQTT existant, accessible depuis le conteneur.
# Laisser vide pour utiliser uniquement l'API HTTP et le stockage.
MQTT_BROKER=

# Identifiants du broker, si une authentification est requise.
MQTT_USERNAME=
MQTT_PASSWORD=

HEARTBEAT_INTERVAL=5s

STORAGE_ROOT=/data