FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app/vendor-video
COPY videostreaming/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt ffmpeg-python==0.2.0
COPY videostreaming/ /app/vendor-video/
COPY integrations/video/ /app/video/
RUN useradd -u 10001 -M worker && mkdir /data && chown 10001:10001 /data
USER 10001:10001
CMD ["python","secure_services.py"]
