FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY auth/src/ ./
RUN mkdir /out && javac -encoding UTF-8 -d /out secucloud/auth/*.java
FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* && mkdir /data && chown 10001:10001 /data
COPY --from=build /out/ /app/classes/
ARG VERSION=dev
LABEL org.opencontainers.image.revision=$VERSION
LABEL org.opencontainers.image.source="https://github.com/julesdavidou/projet_secu_cloud"
USER 10001:10001
HEALTHCHECK --interval=3s --timeout=3s --retries=30 CMD curl -fsS http://127.0.0.1:8082/health || exit 1
CMD ["java", "-Duser.home=/data", "-Dweb.bind=0.0.0.0", "-Dweb.port=8082", "-cp", "/app/classes", "secucloud.auth.WebApplicationServer"]
